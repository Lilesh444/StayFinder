    <!-- Listings grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3
                row-cols-xl-4 g-4">

        <% for (let listing of allListings) { %>

            <div class="col">
                <a href="/listing/<%= listing._id %>"
                   class="text-decoration-none text-dark">

                    <div class="card border-0 h-100 stay-card">

                        <!-- Image -->
                        <div class="stay-image-wrapper">

                            <img
                                src="<%= listing.image.url %>"
                                class="card-img-top stay-image"
                                alt="<%= listing.title %>"
                                loading="lazy"
                            >

                            <span class="badge rounded-pill bg-white text-dark
                                         position-absolute top-0 start-0 m-3">
                                Guest favorite
                            </span>

                            <span class="stay-heart">
                                <i class="fa-regular fa-heart"></i>
                            </span>

                        </div>

                        <!-- Listing details -->
                        <div class="card-body px-0 pt-3">

                            <div class="d-flex justify-content-between
                                        align-items-start gap-2">

                                <h6 class="fw-semibold mb-1">
                                    <%= listing.title %>
                                </h6>

                                <span class="text-nowrap small">
                                    <i class="fa-solid fa-star"></i>
                                    4.9
                                </span>

                            </div>

                            <p class="text-muted small mb-1">
                                <i class="fa-solid fa-location-dot me-1"></i>
                                <%= listing.location %><% if (listing.country) { %>,
                                <%= listing.country %><% } %>
                            </p>

                            <p class="text-muted small mb-2 stay-description">
                                <%= listing.description %>
                            </p>

                            <p class="mb-0">
                                <strong>
                                    &#8377;<%= listing.price.toLocaleString("en-IN") %>
                                </strong>
                                <span class="small">night</span>
                            </p>

                        </div>

                    </div>
                </a>
            </div>

        <% } %>

    </div>

</div>