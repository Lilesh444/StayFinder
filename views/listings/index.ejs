        <div>
            <h2 class="fw-bold mb-1">Explore stays</h2>
            <p class="text-muted mb-0">
                Find your perfect place to stay.
            </p>
        </div>

        <a href="/listing/new" class="btn btn-dark rounded-pill px-4">
            <i class="fa-solid fa-plus me-2"></i>Add Listing
        </a>
    </div>

    <!-- Categories -->
