<% layout("/layouts/boilerPlate") %>

    <style>
        .home-hero {
            min-height: 85vh;
            margin: -20px -12px 0;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
            background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), url("https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=2000&q=85");
            background-size: cover;
            background-position: center;
        }

        .hero-content {
            color: white;
            max-width: 750px;
            padding: 30px;
        }

        .hero-content h1 {
            font-size: clamp(55px, 8vw, 95px);
            font-weight: 800;
            letter-spacing: -3px;
            margin: 0 0 20px;
        }

        .hero-content h1 span {
            color: #ff385c;
        }

        .hero-content p {
            font-size: 19px;
            line-height: 1.7;
            color: #f1f1f1;
            margin: 0 auto 30px;
            max-width: 620px;
        }

        .explore-btn {
            display: inline-block;
            padding: 14px 30px;
            background: #ff385c;
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            transition: 0.3s ease;
        }

        .explore-btn:hover {
            background: #e31c46;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        }

        @media (max-width: 600px) {
            .home-hero {
                min-height: 80vh;
            }

            .hero-content h1 {
                font-size: 55px;
                letter-spacing: -2px;
            }

            .hero-content p {
                font-size: 16px;
            }
        }
    </style>
    <div class="home-hero">
        <div class="hero-content">

            <h1>
                Stay<span>finder</span>
            </h1>

            <p>
                Discover unique places to stay, explore beautiful
                destinations, and find a space that feels like home.
                Stayfinder makes finding your perfect stay simple
                and memorable.
            </p>

            <a href="/listing" class="explore-btn">
                Explore Stays →
            </a>

        </div>

    </div>