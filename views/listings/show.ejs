<% layout("/layouts/boilerPlate") %>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="mb-4">
                <h3><%= listing.title %></h3>
            </div>


            <div class="card listing-details-card">

                <!-- Listing Image -->
                <img src="<%= listing.image %>" class="card-img-top listing-show-image" alt="<%= listing.title %>">


                <div class="card-body">

                    <!-- Title -->
                    <!-- <h4 class="card-title mb-3">
                        <%= listing.title %>
                    </h4> -->


                    <!-- Description -->
                    <p class="card-text mb-4">
                        <%= listing.description %>
                    </p>


                    <!-- Details -->
                    <div class="listing-details">

                        <p>
                            <strong>Price:</strong>
                            &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
                        </p>

                        <p>
                            <strong>Location:</strong>
                            <%= listing.location %>
                        </p>

                        <p>
                            <strong>Country:</strong>
                            <%= listing.country %>
                        </p>

                    </div>


                    <!-- Buttons -->
                    <div class="d-flex gap-2 mt-4">

                        <a href="/listing/<%= listing._id %>/edit" class="btn btn-primary">
                            <i class="fa-solid fa-pen"></i>
                            Edit
                        </a>


                        <form action="/listing/<%= listing._id %>/delete?_method=DELETE" method="post">

                            <button type="submit" class="btn btn-danger">
                                <i class="fa-solid fa-trash"></i>
                                Delete
                            </button>

                        </form>

                    </div>


                    <!-- Review Section -->
                    <div class="mt-5 pt-4 border-top">

                        <h4 class="mb-4">Leave a Review</h4>

                        <form action="/listing/<%= listing._id %>/reviews/newreview" method="post" novalidate
                            class="needs-validation">

                            <div class="mb-3">
                                <label for="rating" class="form-label">
                                    Rating
                                </label>
                                <input type="range" min="1" max="5" id="rating" name="rating" class="form-range">
                            </div>
                            <div class="mb-3">
                                <label for="comment" class="form-label">
                                    Comment
                                </label>

                                <textarea name="comment" id="comment" rows="5" class="form-control"
                                    placeholder="Write your review here..." required></textarea>
                                <div class="invalid-feedback">
                                    plz leave some comments
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Submit
                            </button>
                        </form>
                    </div>
                    <!-- All Reviews -->
                    <div class="mt-5 pt-4 border-top">
                        <h4 class="mb-4">All Reviews</h4>

                        <div class="row g-3">

                            <% for(review of listing.reviews){ %>

                                <div class="col-md-6">

                                    <div class="card h-100 border rounded-3 shadow-sm">
                                        <div class="card-body p-3">

                                            <h6 class="fw-bold mb-2">
                                                John Doe
                                            </h6>

                                            <p class="mb-2 text-dark">
                                                <strong>Rating:</strong>
                                                <%= review.rating %>/5
                                            </p>

                                            <p class="text-muted mb-0">
                                                <%= review.comment %>
                                            </p>

                                        </div>
                                        <form
                                            action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            class="mb-3 px-3" method="post">
                                            <button class="btn btn-danger btn-sm ">Delete</button>
                                        </form>
                                    </div>

                                </div>

                                <% } %>

                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>