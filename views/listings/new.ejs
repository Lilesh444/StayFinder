<% layout("/layouts/boilerPlate") %>

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="mb-4">
                <h3>Add New Listing</h3>
                <p class="text-muted">
                    Add the details of your new listing.
                </p>
            </div>


            <form action="/listing/new" method="post" novalidate class="needs-validation">

                <div class="mb-3">
                    <label for="title" class="form-label">
                        Title
                    </label>

                    <input type="text" id="title" name="title" class="form-control" placeholder="Enter title" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>


                <div class="mb-3">
                    <label for="description" class="form-label">
                        Description
                    </label>

                    <textarea id="description" name="description" class="form-control" placeholder="Enter description"
                        rows="5" required></textarea>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        plz enter a valid Description
                    </div>
                </div>


                <div class="mb-3">
                    <label for="image" class="form-label">
                        Image URL
                    </label>

                    <input type="text" id="image" name="image" class="form-control" placeholder="Enter image URL">
                </div>


                <div class="mb-3">
                    <label for="price" class="form-label">
                        Price per night
                    </label>

                    <input type="number" id="price" name="price" class="form-control" placeholder="Enter price"
                        required>
                    <div class="invalid-feedback">
                        plz enter a valid price
                    </div>
                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label for="location" class="form-label">
                            Location
                        </label>

                        <input type="text" id="location" name="location" class="form-control"
                            placeholder="Enter location" required>
                        <div class="invalid-feedback">
                            plz enter a valid Location
                        </div>
                    </div>


                    <div class="col-md-6 mb-3">

                        <label for="country" class="form-label">
                            Country
                        </label>

                        <input type="text" id="country" name="country" class="form-control" placeholder="Enter country"
                            required>
                        <div class="invalid-feedback">
                            plz enter a valid Country
                        </div>
                    </div>

                </div>


                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    Add Listing
                </button>

            </form>

        </div>

    </div>